# ============================================================
# Cloudflare Pages — HTTP Response Headers
# Applied at the CDN edge; replaces Netlify-specific headers.
# ============================================================

# ── Long-term caching for fingerprinted Next.js assets ──────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ── Long-term caching for pre-generated WebP images ─────────
/img/*
  Cache-Control: public, max-age=31536000, immutable

# ── Global security headers ──────────────────────────────────
/*
  # Force HTTPS for 1 year; include subdomains.
  # NOTE: Only effective on HTTPS origins (Cloudflare always serves HTTPS).
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent MIME-type sniffing attacks.
  X-Content-Type-Options: nosniff

  # Limit Referer information to same-origin; send origin-only cross-origin.
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict embedding to same origin only.
  X-Frame-Options: SAMEORIGIN

  # Restrict browser feature access — tightened to only what the site needs.
  # Camera/microphone/payment: not used. Clipboard write: used by copy buttons.
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(), clipboard-write=(self)

  # Content Security Policy
  # - default-src: deny everything not explicitly listed
  # - script-src: Next.js inlines JSON state blobs via __NEXT_DATA__ (unsafe-inline
  #   is required for the static RSC payload scripts that Next.js 15/16 generates).
  # - style-src: Tailwind inlines critical CSS; Plus Jakarta Sans loads from Google.
  # - font-src: Google Fonts CDN.
  # - img-src: self + data URIs (SVG inline), og-image served from same origin.
  # - connect-src: FormSubmit AJAX endpoint for feedback form.
  # - frame-ancestors: replaces X-Frame-Options in CSP-aware browsers.
  #
  # WARNING: unsafe-inline in script-src is required because Next.js 15/16 static
  # export embeds large inline JSON/JS payloads. Nonce-based CSP is not feasible
  # with static export (no server runtime). This is a known trade-off documented
  # at https://nextjs.org/docs/app/building-your-application/configuring/content-security-policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formsubmit.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://formsubmit.co https://wa.me https://t.me
